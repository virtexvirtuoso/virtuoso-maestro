[Unit]
Description=Bybit Tick Data Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linuxuser
WorkingDirectory=/home/linuxuser/tick_collector
ExecStart=/home/linuxuser/tick_collector/venv/bin/python collector.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
