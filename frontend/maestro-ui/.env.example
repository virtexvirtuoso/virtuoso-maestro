# Maestro UI Environment Configuration
# Copy this file to .env and update values for your environment

# Backend REST API URL
REACT_APP_REST_API_URL=http://localhost:5050

# Backend REST API V2 URL (for newer endpoints)
REACT_APP_REST_API_V2_URL=http://localhost:5050

# WebSocket host for real-time updates
REACT_APP_WS_HOST=localhost:8000

# Optuna Dashboard URL (optional)
# If configured, enables embedded Optuna dashboard iframe
# Run: optuna-dashboard sqlite:///optuna.db --port 8080
REACT_APP_OPTUNA_DASHBOARD_URL=http://localhost:8080
